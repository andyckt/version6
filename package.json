{
  "name": "travel-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate-merchants": "ts-node --project tsconfig.json src/scripts/migrateMerchants.ts",
    "migrate-merchants-cjs": "ts-node --project tsconfig.json --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/migrateMerchantsCjs.ts",
    "migrate-merchants-js": "node src/scripts/migrateMerchantsCjs.js",
    "migrate-from-json": "node src/scripts/migrateFromJson.js",
    "export-merchants": "ts-node --project tsconfig.json src/scripts/exportMerchantsToJson.ts",
    "import-merchants": "node src/scripts/importFromJsonFile.js",
    "migrate-2step": "npm run export-merchants && npm run import-merchants",
    "test-cache": "ts-node --project tsconfig.json src/scripts/testCache.ts"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.5",
    "@types/nodemailer": "^6.4.17",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.6.2",
    "ioredis": "^5.3.2",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.484.0",
    "mongodb": "^6.14.2",
    "next": "^14.1.0",
    "nodemailer": "^6.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "swr": "^2.3.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
